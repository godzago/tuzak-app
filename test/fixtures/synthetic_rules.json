    {"id": "short-link", "reason": "shortLink", "kind": "host", "weight": 0.3, "patterns": ["short.test"]},
    {"id": "brand-mismatch", "reason": "brandMismatch", "kind": "brandMismatch", "weight": 0.55, "patterns": []},
    {"id": "risky-tld", "reason": "suspiciousDomain", "kind": "tld", "weight": 0.15, "patterns": ["example"]}
  ]
}
